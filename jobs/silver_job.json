{
  "name": "pp_industrial_silver",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "trigger": {
    "pause_status": "UNPAUSED",
    "table_update": {
      "table_names": [
        "datapulse.bronze.sensor_events"
      ]
    }
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "pp_preprocess",
      "run_if": "ALL_SUCCESS",
      "spark_python_task": {
        "python_file": "/notebooks/silver/pre_process.py"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "environment_key": "Default",
      "disabled": false
    }
  ],
  "queue": {
    "enabled": true
  },
  "environments": [
    {
      "environment_key": "Default",
      "spec": {
        "environment_version": "6"
      }
    }
  ],
  "performance_target": "PERFORMANCE_OPTIMIZED"
}