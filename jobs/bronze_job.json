{
  "name": "pp_ingestao",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "schedule": {
    "quartz_cron_expression": "51 0 20 * * ?",
    "timezone_id": "America/Sao_Paulo",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "pp_data_raw",
      "run_if": "ALL_SUCCESS",
      "spark_python_task": {
        "python_file": "/notebooks/bronze/create_bronze.py"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "environment_key": "Default",
      "disabled": false
    }
  ],
  "queue": {
    "enabled": true
  },
  "environments": [
    {
      "environment_key": "Default",
      "spec": {
        "environment_version": "6"
      }
    }
  ],
  "performance_target": "PERFORMANCE_OPTIMIZED"
}